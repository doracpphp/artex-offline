# Docker deployment configuration (copy to .env)
# docker-compose.yml builds the image locally. docker-compose.ghcr.yml pulls the
# released GHCR image; pin it with ARTEX_IMAGE_TAG (latest or a vX.Y.Z tag).
# Address the web UI is published on. 127.0.0.1 keeps it host-local; set 0.0.0.0
# to reach it from another machine or from Windows when ARTEX runs inside WSL.
ARTEX_BIND_ADDR=127.0.0.1
# Reverse proxies (comma-separated CIDRs) whose X-Forwarded-For the login rate
# limit trusts. Empty: the header is ignored. See "Reverse proxy deployment" in README.md.
ARTEX_TRUSTED_PROXIES=
# Optional key for the secrets encrypted in the database (32 bytes, base64 or hex,
# e.g. `openssl rand -base64 32`). Empty: keys/secret.key, generated at first start.
# Set it when ./keys is not persistent. Losing the key loses the stored secrets.
# ARTEX_SECRET_KEY=
POSTGRES_USER=artex
# The server percent-encodes this into the connection URL, so / ? % @ : and
# spaces are safe. Quote a value that contains #, and write $$ for a literal $,
# because Compose reads this file that way.
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex
# Prebuilt GHCR image tag for docker-compose.ghcr.yml. Unset uses latest.
# ARTEX_IMAGE_TAG=latest

# Offline / local-LLM-only mode. ON by default: ARTEX uses ONLY a local LLM and
# refuses its own third-party connections — cloud LLM APIs, the GitHub update
# check, external notifications (email/Telegram/DingTalk/Feishu/WeCom/webhook),
# web search, remote MCP servers, cloud archive stores and egress proxies. The LLM
# endpoint host must resolve to a local address, so Ollama, a local Strata
# gateway, or any other local OpenAI/Anthropic-compatible server works while
# api.anthropic.com / api.openai.com are rejected. Set ARTEX_OFFLINE=0 (or
# false/off/no) to restore the original online behavior and allow cloud providers.
# ARTEX_OFFLINE=0
#
# "Local" = loopback, RFC1918, IPv6 ULA, plus ARTEX_OFFLINE_ALLOW_CIDRS; cloud
# metadata endpoints never count. This is the single authority for every agent
# connection ARTEX makes (WebFetch, custom HTTP tool, recording proxy, SOCKS5,
# transparent relay) and for the egress firewall; the per-task target gate can only
# narrow it. Pentest targets on public addresses must be listed here. IP/CIDR
# literals only, comma-separated:
# ARTEX_OFFLINE_ALLOW_CIDRS=203.0.113.0/24
# Package installs in agent shells (pip/apt/npm/go install ...) are refused with a
# pointer to the list_tools tool. Allow them again, e.g. for a local mirror:
# ARTEX_DENY_INSTALLS=0
#
# Egress firewall: docker-compose.yml turns it on by default while offline mode is
# on (iptables in the container, NET_ADMIN dropped afterwards). It stops tools in
# agent shells that connect directly. It does not stop DNS lookups or a relay on an
# allowed range. If it cannot be applied the container does not start; to start
# anyway (the web UI then shows a banner):
# ARTEX_OFFLINE_FIREWALL_ALLOW_DEGRADED=1
# Turn it off (a banner then says there is no firewall):
# ARTEX_OFFLINE_FIREWALL=0
# Running without it but enforcing egress on the host / network instead:
# ARTEX_EGRESS_FIREWALL_EXTERNAL=1

# Offline knowledge search (docs/offline-knowledge-search.md). On by default: when
# a signed knowledge pack (ExploitDB, NVD, technique docs) is imported, the agent
# gets local search_exploits / lookup_cve / lookup_software / search_technique /
# read_knowledge / copy_knowledge_file tools — the offline substitute for web
# search. Build a pack on an online machine with the artex-knowledge command and
# import it under System → Knowledge (or POST /api/knowledge/import). Set to 0 to
# turn the feature off.
# ARTEX_KNOWLEDGE=0
# Directory for imported packs (default: <data dir>/knowledge).
# ARTEX_KNOWLEDGE_DIR=
# Trust a pack signing key before one is embedded in the binary (base64 ed25519
# public key from `artex-knowledge keygen`), and the key id it signs under:
# ARTEX_KNOWLEDGE_PUBKEY=
# ARTEX_KNOWLEDGE_KEY_ID=
#
# Hybrid search (Phase 2): point knowledge search at a LOCAL embedding model to add
# semantic (vector) ranking on top of the lexical search. Needs a pgvector-enabled
# Postgres (swap the postgres image for pgvector/pgvector:pg16); without it, or
# without these vars, search stays lexical-only. The endpoint must be local in
# offline mode. The vector index builds in the background after import.
#   Ollama:  ARTEX_KNOWLEDGE_EMBED_MODEL=nomic-embed-text
#            ARTEX_KNOWLEDGE_EMBED_ENDPOINT=http://host.docker.internal:11434
#   OpenAI-compatible gateway with an /v1/embeddings route:  ARTEX_KNOWLEDGE_EMBED_PROVIDER=openai
# Note: the embedding endpoint must serve embeddings. A chat-only local gateway —
# Strata, for instance, exposes chat/completions and Anthropic messages but NO
# embeddings endpoint — cannot be used here. Run a dedicated local embedder (e.g.
# Ollama with nomic-embed-text) for the vector half, even if Strata is your chat
# LLM; or leave these unset and knowledge search stays lexical-only (still useful).
# ARTEX_KNOWLEDGE_EMBED_PROVIDER=ollama
# ARTEX_KNOWLEDGE_EMBED_MODEL=
# ARTEX_KNOWLEDGE_EMBED_ENDPOINT=

# LLM. In offline mode (the default) this must be a LOCAL endpoint:
#   Ollama (keyless):   ARTEX_LLM_PROVIDER=ollama  ARTEX_LLM_BASE_URL=http://host.docker.internal:11434
#   Strata/local gw:    ARTEX_LLM_PROVIDER=openai  ARTEX_LLM_BASE_URL=http://host.docker.internal:<port>/v1
# The cloud keys below are IGNORED while offline mode is on. You can also leave
# everything empty here and configure the local profile in the UI (System -> LLM).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
# A proxy must itself be local in offline mode; a non-local proxy is refused.
ARTEX_LLM_PROXY=
# Allow the UI model list to reach a local endpoint, e.g. host.docker.internal:11434.
# In offline mode all local/private endpoints are allowed automatically, so this is
# only needed when ARTEX_OFFLINE=0.
ARTEX_LLM_PRIVATE_ENDPOINTS=

# Untrusted-output boundary. Frames every tool output between nonce-tagged markers so
# the model treats it as data, not instructions. On by default (unset or empty = on);
# set ARTEX_UNTRUSTED_BOUNDARY=0 (or false/off/no) to disable it. Measured cost: about
# 154 bytes per tool result plus one system note.
# ARTEX_UNTRUSTED_BOUNDARY=0

# Noise profile of the requests ARTEX sends to targets (WebFetch, http custom tools, enrich
# probe). Default off: no limit, requests unchanged. quiet = 2 req/s per host, burst 4,
# 1 in flight; balanced = 5 req/s, burst 10, 2 in flight; aggressive = 20 req/s, burst 40,
# 4 in flight. A profile also adds jitter, backs off on 429/503 and merges identical GETs
# of one task per tool (short cache; WebFetch is paced only). Bash-launched tools are not throttled.
# ARTEX_NOISE_PROFILE=balanced
# User-Agent set on target requests that have none, only under a profile. Empty = unchanged.
# ARTEX_TARGET_USER_AGENT=

# Run budgets (optional). Unset or 0 = unlimited, nothing changes. TASK_* caps a whole task
# (planner rounds and all its workers); INTENT_* caps one worker run. Kept in memory: a
# restart, or a revive of a finished task, starts a fresh budget.
# Below 50000 tokens a task gets no worker at all (one worker costs about 50000 tokens by
# default); from 50000 to about 70000 it typically gets one worker, then the forced wrap-up. Use a
# budget well above 70000 for real exploration.
# ARTEX_TASK_BUDGET_TOKENS=
# ARTEX_TASK_BUDGET_TURNS=
# ARTEX_INTENT_BUDGET_TOKENS=
# ARTEX_INTENT_BUDGET_TURNS=

# Update banner (optional). ARTEX_UPDATE_CHECK=1 lets the backend check the public GitHub
# releases API for a newer ARTEX release at most once per 24 h and show a dismissible banner.
# Off by default: unset, no update request is made. IGNORED (forced off) while offline mode
# is on — the check is never made regardless of this value.
# ARTEX_UPDATE_CHECK=1
